# Copy to .env.local for local development. On Render these come from render.yaml.
DATABASE_URL=postgres://localhost:5432/talentgrill_dev
# Optional: defaults to RENDER_EXTERNAL_URL on Render, localhost locally.
APP_BASE_URL=http://localhost:3000

ADMIN_PASSWORD=
# 32+ random chars each: openssl rand -base64 32
ADMIN_COOKIE_SECRET=
AGENT_TOOL_SECRET=
IP_HASH_SALT=
# Comma-separated; these users are flagged internal and excluded from counts.
INTERNAL_PHONES=

PRO_PRICE_PAISE=500
CERT_THRESHOLD=70

# live | stub. Stub needs ALLOW_STUBS=true in production and is excluded from counts.
ALLOW_STUBS=false
AGENTICORG_MODE=live
AGENTICORG_BASE_URL=https://agenticorg.hackathon.pinelabs.com
AGENTICORG_API_KEY=
# UUID of FresherCoachAgent (visibility: shared)
AGENTICORG_AGENT_ID=
# UUID of CourseCreatorAgent "Matt" (visibility: shared); practice courses are hidden while unset
AGENTICORG_COURSE_AGENT_ID=
# UUID of ResumeReaderAgent (visibility: shared); FresherCoachAgent reads resumes while unset
AGENTICORG_RESUME_AGENT_ID=
ELEVENLABS_MODE=live
# Live two-way voice interview; set false to fall back to question-by-question
LIVE_INTERVIEW_ENABLED=true
# Needs Text to Speech and Speech to Text access. Stub mode works without it.
ELEVENLABS_API_KEY=
# Optional: defaults to the premade "Rachel" voice.
ELEVENLABS_VOICE_ID=
# Payments are on hold for the event
PAYMENTS_ENABLED=false
PINELABS_MODE=live
# uat | production
PINELABS_ENV=uat
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=
PINELABS_WEBHOOK_SECRET=
VOBIZ_ENABLED=false
